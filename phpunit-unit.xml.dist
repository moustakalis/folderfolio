<?xml version="1.0" encoding="UTF-8"?>
<!--
    The unit suite. No WordPress, no database, no bootstrap beyond two
    require_once lines — it runs in milliseconds.

    Kept in its own config rather than as a second <testsuite> because the two
    suites need different bootstraps, and PHPUnit has no per-suite bootstrap.
    Integration tests live in phpunit.xml.dist and need the WordPress test
    library.

    Every attribute here is valid on PHPUnit 9 through 12. composer.json pins
    ^9.6 for the WordPress test library, so a config using 10+ elements
    (cacheDirectory, <source>) would fail validation on the version CI
    actually installs.
-->
<phpunit
    bootstrap="tests/bootstrap-unit.php"
    colors="true"
    failOnRisky="true"
    failOnWarning="true"
    beStrictAboutOutputDuringTests="true"
>
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
    </testsuites>
</phpunit>
