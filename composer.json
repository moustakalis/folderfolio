{
    "name": "nickosmoustakas/folderfolio",
    "description": "WordPress Media Library folder organization plugin",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "autoload": {
        "psr-4": {
            "FolderFolio\\": "includes/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^2.2",
        "yoast/phpunit-polyfills": "^2.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "php-stubs/wordpress-stubs": "^7.1"
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c phpunit-unit.xml.dist",
        "test:integration": "phpunit",
        "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=1G"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/php-content-repository": false
        }
    }
}
