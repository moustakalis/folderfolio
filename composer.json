{
  "name": "nickosmoustakas/folderfolio",
  "description": "WordPress Media Library folder organization plugin",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "autoload": {
    "psr-4": {
      "FolderFolio\\": "src/"
    }
  },
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "phpstan/phpstan": "^1.10",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse src tests --level max --memory-limit=256M"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/php-content-repository": false
    }
  }
}
