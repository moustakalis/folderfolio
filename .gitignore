# Dependencies
node_modules/
vendor/

# Yarn Berry: the lockfile and .yarnrc.yml are committed, the rest is local
# state. Releases/patches/plugins would be committed if this project ever
# used them.
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*

# Build output.
#
# `assets/build/` rather than a bare `build/`: gitignore patterns without a
# slash match at every depth, so `build/` also ignored a top-level build/
# directory — which is where the esbuild scripts first lived, and why they are
# in tools/ now. Naming the real output directory removes the trap.
assets/build/
dist/

# PHPStan
var/
.phpstan.resultCache.php

# Test coverage and results
coverage/
.phpunit.result.cache
playwright-report/
test-results/

# Editor/IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Local mise overrides
.mise.local.toml

# Files delivered into the folder by Claude
Claude outputs/
