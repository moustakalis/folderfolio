includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6

    # The whole range the plugin claims to support, not the one that happens
    # to be installed.
    #
    # `composer.json` requires >=8.1 and CI runs the test matrix on 8.1 through
    # 8.4, but PHPStan analyses against the running interpreter unless told
    # otherwise — so three `true|WP_Error` return types, which are PHP 8.2
    # syntax, passed every local check and then fatalled the 8.1 leg at parse
    # time, before a single test ran. With a range, PHPStan reports anything
    # that is not valid across all of it.
    phpVersion:
        min: 80100
        max: 80400

    paths:
        - folderfolio.php
        - includes

    bootstrapFiles:
        - phpstan-bootstrap.php

    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        # includes/Cli/* is only ever loaded under WP-CLI, so WP_CLI is
        # undefined to the analyser without this. Hand-written rather than
        # php-stubs/wp-cli-stubs, which caps wordpress-stubs at ^6.0 while
        # this plugin pins ^7.1 — Composer cannot satisfy both.
        - phpstan/wp-cli-stubs.php

    tmpDir: var/phpstan
