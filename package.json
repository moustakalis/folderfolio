{
  "name": "folderfolio-assets",
  "version": "0.2.0",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:js": "esbuild assets/src/core/*.ts --bundle --outdir=assets/build/core --format=iife --minify --sourcemap",
    "build:css": "esbuild assets/src/core/admin.css assets/src/core/media-modal.css --bundle --outdir=assets/build/core",
    "build": "yarn typecheck && yarn build:js && yarn build:css",
    "dev": "yarn build:css && esbuild assets/src/core/*.ts --bundle --outdir=assets/build/core --format=iife --watch --sourcemap",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0"
  },
  "dependenciesMeta": {
    "@playwright/test": {
      "built": false
    },
    "esbuild": {
      "built": false
    }
  }
}
