{
  "name": "folderfolio-assets",
  "version": "0.2.0",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "yarn typecheck && node tools/esbuild.mjs",
    "dev": "node tools/esbuild.mjs --watch",
    "test:pipeline": "node tools/verify-pipeline.mjs",
    "test:slot": "node tools/verify-toolbar-slot.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@wordpress/element": "^6.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0"
  },
  "dependenciesMeta": {
    "@playwright/test": {
      "built": false
    },
    "esbuild": {
      "built": false
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5",
    "zustand": "^5"
  }
}
